{
  "name": "requireapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore \"npx vitest run firestore-rules-tests/firestoreRules.test.ts\"",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^12.15.0",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
